# Copy to .env and adjust. Unset values use the defaults in A2A/server.py.

# Uvicorn bind address. 0.0.0.0 works locally and on a public host.
# HOST=0.0.0.0

# Local development:
# BASE_URL=http://localhost:8001
# PORT=8001

# Live / Docker (Traefik → container port 8086):
# BASE_URL=https://learn-a2a.com
# PORT=8086
